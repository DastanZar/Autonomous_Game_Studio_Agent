{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Research dossier",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "topic",
  "sources",
  "claims"
 ],
 "properties": {
  "topic": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "publisher",
     "url",
     "type",
     "accessed"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "title": {
      "type": "string"
     },
     "publisher": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "type": {
      "enum": [
       "primary",
       "scholarly",
       "official",
       "reference",
       "journalism",
       "dataset",
       "secondary"
      ]
     },
     "accessed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "cites": {
      "type": "string",
      "description": "What this source itself cites, if it is a tertiary source."
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "claims": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text",
     "sources",
     "status",
     "key"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "text": {
      "type": "string"
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      }
     },
     "quote": {
      "type": "string",
      "description": "Excerpt from the source that supports the claim, copied, not paraphrased."
     },
     "status": {
      "enum": [
       "confirmed",
       "estimate",
       "framed",
       "disputed",
       "rejected"
      ]
     },
     "label": {
      "type": "string",
      "description": "On-screen/voice qualifier. Required for estimate, framed and disputed."
     },
     "key": {
      "type": "boolean",
      "description": "True if the episode collapses without it. Key claims need two independent sources or one primary/scholarly/official."
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "myths": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "myth",
     "truth",
     "sources"
    ],
    "properties": {
     "myth": {
      "type": "string"
     },
     "truth": {
      "type": "string"
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]+$"
      }
     }
    }
   }
  },
  "open_questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}