{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Storyboard",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "episode",
  "scenes"
 ],
 "properties": {
  "episode": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "scenes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "type",
     "start",
     "params"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "type": {
      "type": "string"
     },
     "start": {
      "type": "string",
      "pattern": "^([a-z0-9_]+)(\\.(start|end)|/[a-z0-9']+(#\\d+)?)?([+-]\\d+(\\.\\d+)?)?$|^0$"
     },
     "end": {
      "type": "string",
      "pattern": "^([a-z0-9_]+)(\\.(start|end)|/[a-z0-9']+(#\\d+)?)?([+-]\\d+(\\.\\d+)?)?$|^0$"
     },
     "params": {
      "type": "object"
     },
     "events": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "at",
        "do"
       ],
       "properties": {
        "at": {
         "type": "string",
         "pattern": "^([a-z0-9_]+)(\\.(start|end)|/[a-z0-9']+(#\\d+)?)?([+-]\\d+(\\.\\d+)?)?$|^0$"
        },
        "do": {
         "type": "string"
        },
        "args": {
         "type": "object"
        },
        "sfx": {
         "type": "string"
        }
       }
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "flagship": {
   "type": "string",
   "minLength": 20,
   "description": "Why this episode is hand-built (custom scenes may exceed 20% of runtime). Strategy-model use only."
  },
  "theme": {
   "type": "string",
   "description": "Overrides the bible's look.theme for this episode (e.g. 'data-flags' for a flat, texture-free render)."
  },
  "kits": {
   "type": "array",
   "items": {
    "enum": [
     "paper",
     "kinetic",
     "flight",
     "flagart",
     "body",
     "rank",
     "sketch"
    ]
   },
   "description": "Shared drawing kits loaded before the episode's scenes.js (studio/engine/kits/)."
  },
  "flags": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Flag codes (studio/assets/flags/<code>.svg) the flagart kit preloads."
  },
  "drift": {
   "type": "number",
   "minimum": 0,
   "maximum": 0.15,
   "description": "Slow push-in per scene (0.06 = 6% over the scene) so no beat sits still; captions are not affected."
  },
  "pace": {
   "type": "number",
   "minimum": 0.5,
   "maximum": 2,
   "description": "sketch kit: >1 draws and moves the camera slower"
  },
  "hand": {
   "enum": [
    "glove",
    "photo"
   ],
   "description": "sketch kit: the drawing hand"
  }
 }
}
