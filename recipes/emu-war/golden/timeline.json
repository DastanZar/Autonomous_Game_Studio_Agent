 "caps": [
  {
   "text": "IN 1932,",
   "line": "hook",
   "start": 0.35,
   "end": 1.57
  },
  {
   "text": "AUSTRALIA WENT TO WAR",
   "line": "hook",
   "start": 1.57,
   "end": 2.61
  },
  {
   "text": "AGAINST BIRDS.",
   "line": "hook",
   "start": 2.61,
   "end": 3.651
  },
  {
   "text": "AND LOST.",
   "line": "lost",
   "start": 3.781,
   "end": 4.505
  },
  {
   "text": "AFTER WORLD WAR ONE,",
   "line": "vets",
   "start": 4.935,
   "end": 6.135
  },
  {
   "text": "THE GOVERNMENT GAVE VETERANS",
   "line": "vets",
   "start": 6.135,
   "end": 7.055
  },
  {
   "text": "FARMLAND",
   "line": "vets",
   "start": 7.055,
   "end": 7.475
  },
  {
   "text": "IN WESTERN AUSTRALIA.",
   "line": "vets",
   "start": 7.475,
   "end": 9.037
  },
  {
   "text": "THEN 20,000 EMUS",
   "line": "emus",
   "start": 9.117,
   "end": 10.337
  },
  {
   "text": "SHOWED UP,",
   "line": "emus",
   "start": 10.337,
   "end": 10.817
  },
  {
   "text": "AND STARTED EATING",
   "line": "emus",
   "start": 10.817,
   "end": 11.737
  },
  {
   "text": "THE WHEAT.",
   "line": "emus",
   "start": 11.737,
   "end": 12.511
  },
  {
   "text": "SO THE FARMERS",
   "line": "call",
   "start": 12.641,
   "end": 13.301
  },
  {
   "text": "CALLED THE ARMY.",
   "line": "call",
   "start": 13.301,
   "end": 14.665
  },
  {
   "text": "THE ARMY SENT",
   "line": "sent",
   "start": 14.745,
   "end": 15.305
  },
  {
   "text": "ONE MAJOR,",
   "line": "sent",
   "start": 15.305,
   "end": 15.845
  },
  {
   "text": "TWO SOLDIERS,",
   "line": "sent",
   "start": 15.845,
   "end": 16.925
  },
  {
   "text": "TWO MACHINE GUNS,",
   "line": "sent",
   "start": 16.925,
   "end": 17.985
  },
  {
   "text": "AND 10,000 BULLETS.",
   "line": "sent",
   "start": 17.985,
   "end": 19.393
  },
  {
   "text": "THE EMUS SPLIT",
   "line": "scatter",
   "start": 19.573,
   "end": 20.213
  },
  {
   "text": "INTO TINY GROUPS,",
   "line": "scatter",
   "start": 20.213,
   "end": 21.053
  },
  {
   "text": "AND RAN OUT OF RANGE.",
   "line": "scatter",
   "start": 21.053,
   "end": 22.491
  },
  {
   "text": "WHEN 1,000 OF THEM",
   "line": "ambush",
   "start": 22.621,
   "end": 23.361
  },
  {
   "text": "FINALLY WALKED",
   "line": "ambush",
   "start": 23.361,
   "end": 24.041
  },
  {
   "text": "INTO AN AMBUSH...",
   "line": "ambush",
   "start": 24.041,
   "end": 25.133
  },
  {
   "text": "THE GUN JAMMED.",
   "line": "jam",
   "start": 25.313,
   "end": 26.245
  },
  {
   "text": "SO THEY MOUNTED",
   "line": "truck",
   "start": 26.575,
   "end": 27.115
  },
  {
   "text": "A GUN ON A TRUCK.",
   "line": "truck",
   "start": 27.115,
   "end": 28.367
  },
  {
   "text": "THE EMUS WERE",
   "line": "faster",
   "start": 28.447,
   "end": 29.047
  },
  {
   "text": "FASTER THAN THE TRUCK.",
   "line": "faster",
   "start": 29.047,
   "end": 30.204
  },
  {
   "text": "BY DECEMBER:",
   "line": "tally",
   "start": 30.484,
   "end": 31.324
  },
  {
   "text": "NEARLY 10,000 BULLETS,",
   "line": "tally",
   "start": 31.324,
   "end": 32.524
  },
  {
   "text": "FOR 986 EMUS.",
   "line": "tally",
   "start": 32.524,
   "end": 34.935
  },
  {
